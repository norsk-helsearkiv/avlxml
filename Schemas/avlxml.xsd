<?xml version="1.0" encoding="utf-8" ?>
<xs:schema xmlns:avlmdk="http://www.arkivverket.no/standarder/nha/avlxml/avlxml-mdk"
  xmlns:avlsup="http://www.arkivverket.no/standarder/nha/avlxml/avlsup"
  xmlns="http://www.arkivverket.no/standarder/nha/avlxml" elementFormDefault="qualified"
  targetNamespace="http://www.arkivverket.no/standarder/nha/avlxml"
  xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:import schemaLocation="avlxml-mdk.xsd"
    namespace="http://www.arkivverket.no/standarder/nha/avlxml/avlxml-mdk"/>
  <xs:import schemaLocation="avlsup.xsd"
    namespace="http://www.arkivverket.no/standarder/nha/avlxml/avlsup"/>
  <xs:element name="avlxml" type="avlevering"/>

  <xs:complexType name="avlevering">
    <xs:annotation>
      <xs:documentation>Avleveringslisten i AVLXML</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="avlxmlversjon" type="avlmdk:avlxmlversjon"/>
      <xs:element name="avleveringsidentifikator" type="avlmdk:avleveringsidentifikator"/>
      <xs:element name="avleveringsbeskrivelse" type="avlmdk:avleveringsbeskrivelse"/>
      <xs:element name="generertdato" type="avlmdk:generertdato" minOccurs="0"/>
      <xs:element name="arkivskaper" type="avlmdk:arkivskaper"/>
      <xs:element name="avtale" type="avtale"/>
      <xs:element name="pasientjournal" type="pasientjournal" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="avtale">
    <xs:annotation>
      <xs:documentation>Denne klassen beskriver avtalen som avleveringen skjer
        innenfor.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="avtaleidentifikator" type="avlmdk:avtaleidentifikator"/>
      <xs:element name="avtaledato" type="avlmdk:avtaledato"/>
      <xs:element name="avtalebeskrivelse" type="avlmdk:avtalebeskrivelse"/>
      <xs:element name="virksomhet" type="virksomhet"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="virksomhet">
    <xs:annotation>
      <xs:documentation>Denne klassen beskriver virksomheten som omfattes av
        avtalen</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="virksomhetsnavn" type="avlmdk:virksomhetsnavn"/>
      <xs:element name="foretaksnavn" type="avlmdk:foretaksnavn" minOccurs="0"/>
      <xs:element name="organisasjonsnummer" type="avlmdk:organisasjonsnummer"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="diagnose">
    <xs:annotation>
      <xs:documentation> Denne klassen beskriver de enkelte diagnosene som er tilknyttet den fysiske
        pasientjournalen. </xs:documentation>
      <xs:documentation> Merk at denne klassen er kun relevant for fysiske pasientjournaler. For
        diagnoseregistrering av elektroniske pasientjournaler se avlsup. </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="diagnosedato" type="avlmdk:diagnosedato"/>
      <xs:element name="diagnosekode" type="avlmdk:diagnosekode" minOccurs="0"/>
      <xs:element name="diagnosetekst" type="avlmdk:diagnosetekst"/>
      <xs:element name="diagnosekodeverk" type="avlmdk:diagnosekodeverk" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="pasientjournal">
    <xs:annotation>
      <xs:documentation>Denne klassen beskriver hver pasientjournal i avleveringen.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="journalidentifikator" type="avlmdk:journalidentifikator"/>
      <xs:element name="fanearkidentifikator" type="avlmdk:fanearkidentifikator" minOccurs="0"/>
      <xs:element name="arkivskaper" type="avlmdk:arkivskaper" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="lopenummer" type="avlmdk:lopenummer" minOccurs="0"/>
      <xs:element name="journalnummer" type="avlmdk:journalnummer" minOccurs="0"/>
      <xs:element name="fodselsnummer" type="avlmdk:fodselsnummer" minOccurs="0"/>
      <xs:element name="pasientnavn" type="avlmdk:pasientnavn"/>
      <xs:element name="fodtdato" type="avlmdk:fodtdato"/>
      <xs:element name="morsdato" type="avlmdk:morsdato" minOccurs="0"/>
      <xs:element name="sikkermors" type="avlmdk:sikkermors" minOccurs="0"/>
      <xs:element name="kjonn" type="avlmdk:kjonn"/>
      <xs:element name="forstekontakt" type="avlmdk:forstekontakt"/>
      <xs:element name="sistekontakt" type="avlmdk:sistekontakt"/>
      <xs:element name="merknad" type="avlmdk:merknad" minOccurs="0"/>
      <xs:element name="diagnose" type="diagnose" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="lagringsenhet" type="avlmdk:lagringsenhet" minOccurs="0"
        maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
